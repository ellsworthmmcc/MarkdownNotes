{
  "name": "notes-for-markdown",
  "displayName": "Notes for Markdown",
  "description": "Extension to help when taking notes in Markdown",
  "publisher": "ellsworthmmcc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ellsworthmmcc/Notes-for-Markdown"
  },
  "bugs": {
    "url": "https://github.com/ellsworthmmcc/Notes-for-Markdown/issues"
  },
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "notes",
    "list",
    "bullet"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "notes-for-markdown.onEnter",
        "title": "Smart Enter",
        "category": "Notes for Markdown"
      }
    ],
    "keybindings": [
      {
        "command": "notes-for-markdown.onEnter",
        "key": "enter",
        "when": "editorTextFocus && !editorReadonly && editorLangId == markdown && !suggestWidgetVisible && !inSnippetMode"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "18.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}