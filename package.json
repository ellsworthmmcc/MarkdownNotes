{
  "name": "notes-in-markdown",
  "displayName": "Notes in Markdown",
  "description": "Editing helpers for taking notes in Markdown",
  "publisher": "ellsworthmmcc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ellsworthmmcc/Notes-in-Markdown"
  },
  "bugs": {
    "url": "https://github.com/ellsworthmmcc/Notes-in-Markdown/issues"
  },
  "version": "1.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "notes",
    "list",
    "bullet"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "notes-in-markdown.onEnter",
        "title": "Smart Enter",
        "category": "Notes in Markdown"
      },
      {
        "command": "notes-in-markdown.onTab",
        "title": "Smart Tab",
        "category": "Notes in Markdown"
      }
    ],
    "keybindings": [
      {
        "command": "notes-in-markdown.onEnter",
        "key": "enter",
        "when": "editorTextFocus && !editorReadonly && editorLangId == markdown && !suggestWidgetVisible && !inSnippetMode"
      },
      {
        "command": "notes-in-markdown.onTab",
        "key": "tab",
        "when": "editorTextFocus && !editorReadonly && !editorTabMovesFocus && editorLangId == markdown && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode"
      }
    ],
    "configuration": {
      "title": "Notes in Markdown",
      "properties": {
        "notesInMarkdown.bullets.continueOnEnter": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Pressing Enter at the end of a bullet starts the next bullet."
        },
        "notesInMarkdown.bullets.splitOnEnter": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Pressing Enter in the middle of a bullet splits it into two bullets."
        },
        "notesInMarkdown.bullets.removeEmptyOnEnter": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Pressing Enter on an empty bullet removes it and ends the list."
        },
        "notesInMarkdown.bullets.indentOnTab": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Pressing Tab inside a bullet indents the whole line using your editor's indent settings."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "18.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}